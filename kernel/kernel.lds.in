#include <consts/size.h>
#include <arch/arch.h>
#include <arch/layout.h>

OUTPUT_ARCH(riscv)
ENTRY(_start);

SECTIONS {
    . = KERN_BASE;

    .text : ALIGN(4K) {
        __stext = .;
        *(.text.entry)
        *(.text .text.*)
        __etext = .;    
    }

    .rodata : ALIGN(4K) {
        __srodata = .;
        *(.rodata .rodata.*)
        __erodata = .;
    }

    .bss : ALIGN(4K) {
        __sbss = .;
        *(.bss .bss.*)
        *(.sbss .sbss.*)
        *(COMMON)
        __ebss = .;
    }

    . = ALIGN(4K);
    .stack : {
        __boot_stacks_bottom = .;
        . += BOOT_STACK_SIZE * NCPU;
        __boot_stacks_top = .;
    }
    
    // no need to align.

    __ekern = .;
    __smem = .;

    /DISCARD/ : { 
        *(.comment)
        *(.riscv.attributes)
        *(.note.GNU-stack) 
    }
}