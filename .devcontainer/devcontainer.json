{
	"name": "cocos-devcontainer",
	"build": {
		"context": "..",
		"dockerfile": "../Dockerfile",
		"target": "final",
		"args": {
			"QEMU_VERSION": "10.0.5",
			"GNU_VERSION": "2026.01.09"
		}
	},
	// Set your user ID here.
	// If unfortunately your uid is not 1000, then you might
	// need to login as root first and create a user with the same uid as your host user.
	"remoteUser": "1000",
	"customizations": {
		"vscode": {
			"extensions": [
				"llvm-vs-code-extensions.vscode-clangd",
				"donjayamanne.githistory",
				"github.copilot-chat",
				"ms-vscode.hexeditor",
				"ms-python.python"
			],
			"settings": {}
		}
	},
	"postCreateCommand": "echo devcontainer created"
}